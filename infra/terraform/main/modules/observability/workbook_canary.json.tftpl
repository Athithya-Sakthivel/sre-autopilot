${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"
      content = {
        json = format("# Canary Release — %s", environment)
      }
    },
    {
      type = 12
      name = "dashboard"
      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"
        items = [
          {
            type = 3
            name = "traffic_split"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Traffic split"
              query                   = traffic_split_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "areachart"
              size                    = 1
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "error_rate"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Error rate"
              query                   = error_rate_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              chartSettings = { ySettings = { min = 0, max = 100 } }
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "latency"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "P95 latency"
              query                   = latency_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "exceptions"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Exceptions"
              query                   = exceptions_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "table"
              size                    = 0
              noDataMessage = "None"
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
