${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"
      content = {
        json = format("# Task API DB — %s", environment)
      }
    },
    {
      type = 12
      name = "dashboard"
      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"
        items = [
          {
            type = 3
            name = "connections"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Connections"
              query                   = connections_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "cpu"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "CPU %"
              query                   = cpu_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              chartSettings = { ySettings = { min = 0, max = 100 } }
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "storage"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Storage %"
              query                   = storage_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              chartSettings = { ySettings = { min = 0, max = 100 } }
              noDataMessage = "No data"
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
