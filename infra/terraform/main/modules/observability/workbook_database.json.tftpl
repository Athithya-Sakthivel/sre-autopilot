${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"
      content = {
        json = format("# Task API Database — %s", environment)
      }
    },
    {
      type = 12
      name = "dashboard"

      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"

        items = [
          {
            type        = 3
            name        = "connections"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Active connections · 10m average"
              query                   = connections_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                }
              }

              noDataMessage = "No active-connection metric data"
            }
          },
          {
            type        = 3
            name        = "cpu"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "CPU · 10m average"
              query                   = cpu_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No CPU metric data"
            }
          },
          {
            type        = 3
            name        = "storage"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Storage · 10m average"
              query                   = storage_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No storage metric data"
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
