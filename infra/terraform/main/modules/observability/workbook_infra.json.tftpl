${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"
      content = {
        json = format("# Task API Infrastructure — %s", environment)
      }
    },
    {
      type = 12
      name = "dashboard"

      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"

        items = [
          {
            type        = 3
            name        = "api_errors"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "API server errors · 24h"
              query                   = api_errors_query
              size                    = 0
              aggregation             = 1
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                }
              }

              noDataMessage = "No API server errors"
            }
          },
          {
            type        = 3
            name        = "node_cpu"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node CPU · 10m average"
              query                   = node_cpu_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No node CPU metric data"
            }
          },
          {
            type        = 3
            name        = "node_memory"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node memory · 10m average"
              query                   = node_memory_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No node memory metric data"
            }
          },
          {
            type        = 3
            name        = "node_disk"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node disk · 10m average"
              query                   = node_disk_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No node disk metric data"
            }
          },
          {
            type        = 3
            name        = "pod_restarts"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Pod restart growth · 15m"
              query                   = pod_restarts_query

              size        = 0
              aggregation = 0
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "table"

              gridSettings = {
                rowLimit = 10

                sortBy = [
                  {
                    itemKey   = "Restarts"
                    sortOrder = 2
                  }
                ]
              }

              noDataMessage = "No pod restart growth detected in the last 15 minutes"
            }
          }
        ]
      }
    }
  ]

  isLocked             = true
  defaultResourceIds   = [workspace_id]
  fallbackResourceIds  = [workspace_id]
})}
