${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"
      content = {
        json = format("# Task API Infra — %s", environment)
      }
    },
    {
      type = 12
      name = "dashboard"
      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"
        items = [
          {
            type = 3
            name = "api_errors"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "API errors"
              query                   = api_errors_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "node_cpu"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node CPU %"
              query                   = node_cpu_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              chartSettings = { ySettings = { min = 0, max = 100 } }
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "node_memory"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node mem %"
              query                   = node_memory_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              chartSettings = { ySettings = { min = 0, max = 100 } }
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "node_disk"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node disk %"
              query                   = node_disk_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 1
              chartSettings = { ySettings = { min = 0, max = 100 } }
              noDataMessage = "No data"
            }
          },
          {
            type = 3
            name = "pod_restarts"
            customWidth = "50"
            styleSettings = { showBorder = false, margin = "5px" }
            content = {
              version                 = "KqlItem/1.0"
              title                   = "Pod restarts"
              query                   = pod_restarts_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "table"
              size                    = 0
              noDataMessage = "None"
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
