${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"
      content = {
        json = format("# Task API Application SLO — %s", environment)
      }
    },
    {
      type = 12
      name = "dashboard"

      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"

        items = [
          {
            type        = 3
            name        = "availability"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Availability · 24h"
              query                   = availability_query
              size                    = 0
              aggregation             = 0
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "text"

              textSettings = {
                style = "bignumber"
              }

              noDataMessage = "No traffic"
            }
          },
          {
            type        = 3
            name        = "p95"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "P95 latency · 24h"
              query                   = p95_query
              size                    = 0
              aggregation             = 0
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "text"

              textSettings = {
                style = "bignumber"
              }

              noDataMessage = "No latency data"
            }
          },
          {
            type        = 3
            name        = "traffic"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Request count · 10m"
              query                   = traffic_query
              size                    = 0
              aggregation             = 1
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                }
              }

              noDataMessage = "No request data"
            }
          },
          {
            type        = 3
            name        = "errors"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Error rate · 10m"
              query                   = errors_query

              # 3 = Average in KQL workbook query aggregation.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No request/error data"
            }
          },
          {
            type        = 3
            name        = "business_metrics"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Business metrics · 10m"
              query                   = business_metrics_query
              size                    = 0
              aggregation             = 1
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                group      = "Name"
                showLegend = true
                showMetrics = false
              }

              noDataMessage = "No application metrics"
            }
          },
          {
            type        = 3
            name        = "jvm_heap"
            customWidth = "50"

            content = {
              version                 = "KqlItem/1.0"
              title                   = "JVM heap used · 10m"
              query                   = jvm_heap_query

              # 3 = Average.
              size        = 0
              aggregation = 3
              queryType   = 0

              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"

              chartSettings = {
                showLegend  = false
                showMetrics = false

                ySettings = {
                  min = 0
                }
              }

              noDataMessage = "No JVM heap data"
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
